# HeatRoute Environment Variables

# -------------------------------------------------------------
# 1. AWS Location Service Configuration
# -------------------------------------------------------------
# Replace with your Amazon Location Service Map name and API Key
# Region: ap-south-1 (Mumbai) recommended for India / Bharat Build Tour
VITE_AWS_LOCATION_MAP_NAME=HeatRouteMap
VITE_AWS_LOCATION_API_KEY=v1.public.your_api_key_here
VITE_AWS_REGION=ap-south-1

# -------------------------------------------------------------
# 2. HeatRoute Backend API URL
# -------------------------------------------------------------
# Local FastAPI or AWS API Gateway URL
VITE_BACKEND_URL=http://127.0.0.1:8000
